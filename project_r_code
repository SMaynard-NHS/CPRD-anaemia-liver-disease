# RESULTS 4: Kaplan-Meier plot of time to ferritin test within 90d Hb

# To demonstrate testing which allows detection of IDA 

# Need patid, date of index Hb, fer within 90d Hb yn, earliest fer within 90d hb, endoffollowup
time_to_ferritin <- demographics %>%
  select(patid, Index_FirstHb_date, EndOfFUPeriod)

# Merge earliest ferritin obs date per patient from all ferritin within 90d of Hb results (Hb_fer_90d)
time_to_ferritin <- time_to_ferritin %>%
  left_join(Hb_fer_90d %>% select(patid, Ferritin_obsdate, yn_Hb_fer_90d), by = 'patid') %>%
  # Group by patient, arrange by Ferritin_obsdate, then take the earliest
  group_by(patid) %>%
  arrange(Ferritin_obsdate) %>%  # Sort by ferritin obsdate
  slice(1) %>%  # Select the first row (earliest)
  ungroup()  


# Prepare the dataset for time to ferritin test
time_to_ferritin_data <- time_to_ferritin %>% 
  mutate(
    # Calculate time-to-test (in days)
    time_to_ferritin = case_when(
      !is.na(yn_Hb_fer_90d) & yn_Hb_fer_90d == 1 ~ as.numeric(difftime(Ferritin_obsdate, Index_FirstHb_date, units = "days")),
      TRUE ~ as.numeric(difftime(EndOfFUPeriod, Index_FirstHb_date, units = "days"))  # Censored cases (no test)
    ),
    
    # Ensure time_to_ferritin is non-negative if an event occurred
    time_to_ferritin = ifelse(yn_Hb_fer_90d == 1 & time_to_ferritin < 0, 0, time_to_ferritin),
    
    # Create test indicator (1 = had a ferritin test, 0 = no test)
    ferritin_tested = ifelse(yn_Hb_fer_90d == 1, 1, 0)
  ) %>%
  
    # Replace NAs with 0
  replace_na(list(ferritin_tested = 0)) %>%
  select(patid, time_to_ferritin, ferritin_tested)

# Check the summary
summary(time_to_ferritin_data)
hist(time_to_ferritin_data$time_to_ferritin)


# Number of patients who had ferritin test within 12 months (n= 17037)
time_to_ferritin_aggregated <- time_to_ferritin_data %>%
  filter(ferritin_tested == 1 & time_to_ferritin <336 ) %>%
  summarise(count = n())


# Create a survival-like object
time_to_ferritin_obj <- Surv(time = time_to_ferritin_data$time_to_ferritin, 
                             event = time_to_ferritin_data$ferritin_tested)

# Fit the Kaplan-Meier curve (interpreted as time to ferritin test)
km_time_to_ferritin <- survfit(time_to_ferritin_obj ~ 1, data = time_to_ferritin_data)

# Extract survival probabilities and corresponding times
km_df <- data.frame(time = km_time_to_ferritin$time, no_ferritin = km_time_to_ferritin$surv)

# Find the time closest to 50% of patients still without a ferritin test
