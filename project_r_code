# Update remaining data sets to include only those who have no record of liver transplant prior to or on Index Hb

filter_patids_in_demographics <- function() {
  # Ensure demographics dataset exists
  if (!exists("demographics")) {
    stop("Error: demographics dataset not found in the environment.")
  }
  
  # Extract valid patid values
  valid_patids <- demographics$patid
  
  # Get all data frames in the environment
  data_frames <- ls(envir = .GlobalEnv)
  
  # Loop through each data frame
  for (df_name in data_frames) {
    df <- get(df_name, envir = .GlobalEnv)
    
    # Ensure the dataset contains "patid" before filtering
    if (!"patid" %in% colnames(df)) next
    
    # Filter the dataset
    df <- df %>% filter(patid %in% valid_patids)
    
    # Save the updated dataset
    assign(df_name, df, envir = .GlobalEnv)
    message(paste("Filtered:", df_name, "- Remaining rows:", nrow(df)))
  }
  
  message("Filtering complete!")
}

# Run the function
filter_patids_in_demographics()



# Update EndOfFUPeriod aligning with transplant
# Set EndOfFUPeriod to LiverTransplant_obsdate for patids with liver transplant during study if after current EndOfFUPeriod

# Remaining patids in liver tx all study had liver transplant during study period (between Index Hb and EndOfFUPeriod)

liver_tx_remain <- livertx_all_study %>%
  filter(LiverTransplant_obsdate > Index_FirstHb_date) # n = 509 (just checking)

# For all d.fs in environment if patid is within liver_tx_remain and EndOfFUPeriod (observation in environment d.f) is > LiverTransplant_obsdate (observation in liver_tx_remain d.f), change EndOfFUPeriod date to LiverTransplant_obsdate (keep column name the same)
# Then filter all d.fs which have a column containing 'obsdate' to only keep rows where 'obsdate' is <= to EndOfFUPeriod

update_fu_and_filter_obsdates <- function() {
  df_names <- ls(envir = .GlobalEnv)
  
  if (!"liver_tx_remain" %in% df_names) {
    stop("liver_tx_remain dataset not found in the environment.")
  }
  
  liver_tx_remain <- get("liver_tx_remain", envir = .GlobalEnv)
  
  for (df_name in df_names) {
    if (df_name %in% c("liver_tx_remain", "livertx_all_study")) next
    
    df <- get(df_name, envir = .GlobalEnv)
    
    if (!("patid" %in% colnames(df) && "EndOfFUPeriod" %in% colnames(df))) next
    
    message(paste("Processing:", df_name, "- Initial rows:", nrow(df))) # Debugging message
    
    df <- df %>%
      left_join(liver_tx_remain %>% select(patid, LiverTransplant_obsdate), by = "patid") %>%
      mutate(EndOfFUPeriod = if_else(!is.na(LiverTransplant_obsdate) & EndOfFUPeriod > LiverTransplant_obsdate,
                                     LiverTransplant_obsdate, 
                                     EndOfFUPeriod)) %>%
      select(-LiverTransplant_obsdate)
    
    obsdate_columns <- grep("obsdate", colnames(df), value = TRUE, ignore.case = TRUE)
    
    if (length(obsdate_columns) > 0) {
      df <- df %>%
        filter(across(all_of(obsdate_columns), ~ . <= EndOfFUPeriod))
    }
    
    assign(df_name, df, envir = .GlobalEnv)
    message(paste("Updated:", df_name, "- Final rows:", nrow(df))) # Success message
  }
}

update_fu_and_filter_obsdates()



