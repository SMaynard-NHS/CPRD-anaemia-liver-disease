    df <- df %>%
      mutate(patid = as.character(patid))
    
    # Assign the modified data frame back to the original name
    assign(df_name, df, envir = .GlobalEnv)
  }
}

# Change all columns containing "obsdate" to Date format (and Index_FirstHb_date, and EndOfFUPeriod)
for (df_name in data_frames) {
  # Get the data frame
  df <- get(df_name)
  
  # Identify columns containing "date" or "Period"
  date_columns <- grep("date|Period", colnames(df), value = TRUE)
  
  # Apply the transformation if there are any matching columns
  if (length(date_columns) > 0) {
    df <- df %>%
      mutate(across(all_of(date_columns), as.Date))
    
    # Assign the modified data frame back to the original name
    assign(df_name, df, envir = .GlobalEnv)
  }
}


