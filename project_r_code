    if (nrow(coef_summary) > 1) {
      p_values <- coef_summary[-1, 4]  # Extract p-values
      data.frame(
        Predictor = paste(var, rownames(coef_summary)[-1], sep = "_"),  # Include category levels
        OR = round(exp(coef_summary[-1, 1]), 3),  # Exponentiate coefficient
        `CI Lower` = round(exp(conf_int[-1, 1]), 3),  # Lower bound of 95% CI
        `CI Upper` = round(exp(conf_int[-1, 2]), 3),  # Upper bound of 95% CI
        `P value` = sprintf("%.3f", p_values),  # Format p-value with 3 decimal places
